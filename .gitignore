# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Claude Code local state (worktrees, plans, settings)
.claude/

# Conversation-regression (persona) harness output
scripts/regression/conversations/artifacts/

# Session audit cursor + artifacts (local-only state — each dev has their own)
scripts/audits/sessions/.session-audit-cursor.json
scripts/audits/sessions/artifacts/

# Sub-agent runtime audit cursor + artifacts (local-only state)
scripts/audits/sub-agent-runs/.subagent-runtime-audit-cursor.json
scripts/audits/sub-agent-runs/artifacts/

# rescan remediation scratch output (regenerated per run)
scripts/jobs/.rescan-recovered*.tsv
scripts/jobs/.revalidate-reclosed.tsv

* - temporary.yaml