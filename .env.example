# Matches the container in docker-compose.yml, so `docker compose up -d` works
# with this value unchanged. Point it at your own Postgres if you have one.
DATABASE_URL="postgresql://hank:hank@localhost:5432/hank_dev?schema=public"

# ── How this instance is used ────────────────────────────────────────────────
# The three knobs below decide who can sign in and whose API key pays. The
# defaults are for running Hank for yourself. Serving other people flips all
# three — read docs/self-hosting.md first, because at that point you're storing
# personal data on their behalf.

# local — sign in by typing an email. No password, no verification: anyone who
#         can load the page can become any account on it, including an admin.
#         Right for your own machine, never for a public URL.
# oauth — Google / GitHub, using the credentials set further down.
AUTH_MODE="local"

# true  — every account may spend the key below. The single-user default: set
#         DEEPSEEK_API_KEY and it just works.
# false — an account can only spend it once an admin flips canUseServerKey at
#         /admin/users. THAT GRANT IS THE INVITE GATE for a public deployment:
#         a user can sign in but can't run the agent, so they never generate a
#         transcript or a profile. Blocked users get a "request access" button.
SERVER_KEY_BY_DEFAULT="true"

# Whether users may save their own API keys and use Hank on their own dime.
# Off by default. Turning it on means anyone who can sign in can use the app
# without you approving them — so their résumé, chat history, and profile land
# in your database. That configuration needs a privacy policy and terms of
# service of your own; see docs/self-hosting.md.
ALLOW_USER_API_KEYS="false"

# ─────────────────────────────────────────────────────────────────────────────

# DeepSeek runs every LLM call — the main chat agent and every sub-agent.
# This is the SERVER key; a user's own key (when ALLOW_USER_API_KEYS is on)
# always wins over it. Per-user keys are encrypted at rest with
# ANTHROPIC_KEY_ENCRYPTION_KEY (below).
DEEPSEEK_API_KEY=""

# Anthropic is used for the vision carve-out only (resume parsing + logo
# verification) — DeepSeek rejects image input. Server key, same access gate as
# DeepSeek. Optional: the vision features degrade gracefully when no Anthropic
# key is available.
ANTHROPIC_API_KEY="sk-ant-..."

# Public origin used as the metadataBase for OG/Twitter image URLs. Must be
# the deployed origin (https://hank.example.com) in prod; falls back to
# http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=""

# 32 random bytes, base64-encoded — `openssl rand -base64 32`. Master key for
# AES-256-GCM encryption of per-user Anthropic API keys at rest. Required
# whenever a user saves a key or the resolver decrypts one.
ANTHROPIC_KEY_ENCRYPTION_KEY=""

# Auth.js (NextAuth v5). Only needed when AUTH_MODE="oauth" — a provider whose
# ID/SECRET pair is unset simply doesn't render a button.
AUTH_SECRET=""                          # openssl rand -base64 32
AUTH_TRUST_HOST="true"                  # Railway / any proxied env
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Seeding the admin user (one-time / cold start)
SEED_ADMIN_EMAIL=""                     # email to flag as isAdmin=true
SEED_ADMIN_ID=""                        # optional: pin user id on create (otherwise cuid)

# Web Push (admin notify on signup). Generate with `npx web-push generate-vapid-keys`.
# Subject must be a mailto: URL or https:// URL identifying the sender to the push service.
# Per-device subscriptions are stored in the PushSubscription table — add or remove
# them at /admin/push-subscribe without restarting the server.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"
